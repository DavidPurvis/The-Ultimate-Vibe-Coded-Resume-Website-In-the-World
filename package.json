{
  "name": "ultimate-vibe-coded-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A professionally excellent résumé behind a deliberately hostile Department of Recruiter Verification.",
  "license": "Unlicense",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "tsx scripts/vendor-doom.ts",
    "dev": "astro dev",
    "typecheck": "astro check",
    "prebuild:site": "tsx scripts/vendor-doom.ts",
    "build:site": "astro build",
    "build": "npm run typecheck && npm run build:site && tsx scripts/postbuild.ts",
    "postbuild:only": "tsx scripts/postbuild.ts",
    "verify:pdf": "tsx scripts/verify-pdf.ts",
    "scan": "tsx scripts/scan-dist/index.ts",
    "rasterize": "tsx scripts/rasterize.ts",
    "serve:dist": "tsx scripts/serve-dist.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild:hooks": "tsx scripts/vendor-doom.ts",
    "build:hooks": "PUBLIC_TEST_HOOKS=1 astro build --outDir dist-hooks",
    "test:e2e:hooks": "PW_HOOKS=1 playwright test",
    "validate": "npm run format:check && npm run build && vitest run --coverage && npm run scan && playwright test --project=chromium --project=mobile && npm run validate:hooks",
    "validate:hooks": "npm run build:hooks && npm run test:e2e:hooks",
    "test:all": "npm run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor:doom": "tsx scripts/vendor-doom.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.5",
    "matter-js": "0.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/game-icons": "1.2.4",
    "@iconify/utils": "3.1.7",
    "@nicejsisverycool/tizendoom": "0.1.6",
    "@playwright/test": "1.56.1",
    "@types/matter-js": "0.20.2",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "lucide-static": "1.48.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.56.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
