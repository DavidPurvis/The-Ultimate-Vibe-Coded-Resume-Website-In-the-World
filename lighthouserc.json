{
  "ci": {
    "collect": {
      "startServerCommand": "npm run serve:dist",
      "startServerReadyPattern": "Serving dist",
      "url": [
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/resume/",
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/",
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/verify/",
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/casino/",
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/presentation/",
        "http://127.0.0.1:4321/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World/tailor/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/resume/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(verify|casino|presentation|tailor)?/?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
