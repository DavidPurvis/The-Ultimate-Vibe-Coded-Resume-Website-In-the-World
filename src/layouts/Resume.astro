---
/**
 * Layout R: the résumé. No case runtime, no institutional copy, no storage access (its boot
 * script only marks data-js). Calm, fast, print-perfect.
 */
import '../styles/fonts';
import '../styles/tokens.css';
import '../styles/core.css';
import '../styles/print.css';
import Head from '../components/Head.astro';
import type { RouteMeta } from '../content/copy/meta';

interface Props {
  route: RouteMeta;
}
const { route } = Astro.props;
---

<!doctype html>
<html lang="en" data-layout="resume">
  <head>
    <Head
      title={route.title}
      description={route.description}
      path={route.path}
      preloadDisplay={false}
      boot="resume"
    />
    <slot name="head" />
  </head>
  <body class="layout-r">
    <slot name="top" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
