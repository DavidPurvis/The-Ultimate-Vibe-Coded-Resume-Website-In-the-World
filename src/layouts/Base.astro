---
/**
 * Layout G — every gag page. Chaos layer, skip link, escape hatch, print-only résumé copy.
 */
import '../styles/fonts';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import '../styles/ads.css';
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import RickrollDialog from '../components/RickrollDialog.astro';
import CookieBanner from '../components/CookieBanner.astro';
import VendorsDialog from '../components/VendorsDialog.astro';
import ParodyAd from '../components/ParodyAd.astro';
import { PARODY_ADS } from '../content/copy/ads';
import { exits } from '../content/copy/global';
import type { RouteMeta } from '../content/copy/meta';
import { url } from '../lib/paths';

interface Props {
  route: RouteMeta;
  ogTitle?: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { route, ogTitle, bodyClass, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="chaos" data-layout="gag">
  <head>
    <Head
      title={route.title}
      description={route.description}
      path={route.path}
      {...(ogTitle ? { ogTitle } : {})}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class:list={['layout-g', bodyClass]} data-cursor={route.cursor}>
    <a class="skip-link" href={`${url('/resume/')}?mode=recruiter`} data-escape>
      {exits.skipLink}
    </a>
    <SiteHeader currentPath={route.path} {...(route.formId ? { formId: route.formId } : {})} />
    <ParodyAd placement="leaderboard" seed={route.path} />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <ParodyAd placement="banner" seed={route.path} />
    <SiteFooter />
    <span hidden data-parody-ads={JSON.stringify(PARODY_ADS)}></span>
    <div class="print-only" aria-hidden="true">
      <ResumeDocument idPrefix="print" embedded />
    </div>
    <CookieBanner />
    <VendorsDialog />
    <RickrollDialog />
    <slot name="after" />
    <div class="toast-stack" data-toasts role="region" aria-label="Notifications"></div>
    <div id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>

<script>
  import '../scripts/chaos';
</script>
