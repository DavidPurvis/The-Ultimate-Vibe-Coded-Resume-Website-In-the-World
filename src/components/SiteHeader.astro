---
/** The ordinary site header: name, three links, and (on `/` only) the case chip slot. */
import { url } from '../lib/paths';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const links = [
  { path: '/resume/', label: 'Résumé' },
  { path: '/projects/', label: 'Projects' },
  { path: '/#contact', label: 'Contact' },
];
---

<header class="site-bar">
  <div class="container site-bar__inner">
    <a class="site-bar__name" href={url('/')}>
      David Purvis
    </a>
    <nav aria-label="Site">
      <ul class="site-bar__nav">
        {links.map((l) => (
          <li>
            <a href={url(l.path)} aria-current={l.path === currentPath ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <slot name="chip" />
  </div>
</header>
