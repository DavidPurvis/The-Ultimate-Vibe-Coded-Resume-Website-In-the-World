---
import Icon from './Icon.astro';
import { threat } from '../content/copy/global';
---

<div class="threat chaos-only" data-threat data-level="0" role="status">
  <Icon name="shield-alert" size={16} />
  <span>{threat.label}</span>
  <span class="threat__gauge" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </span>
  <span class="threat__value" data-threat-value>
    {threat.levels[0]}
  </span>
</div>
