---
import { getSvg } from '../lib/icons';
import type { IconSet } from '../content/credits';

interface Props {
  set?: IconSet;
  name: string;
  label?: string;
  size?: number;
  class?: string;
}
const { set = 'lucide', name, label, size = 24, class: className } = Astro.props;
const svg = getSvg(set, name, {
  size,
  ...(label ? { label } : {}),
  ...(className ? { className } : {}),
});
---

<Fragment set:html={svg} />
