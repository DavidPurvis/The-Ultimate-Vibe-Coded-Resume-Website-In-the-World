---
/**
 * The Link Roulette wheel: eight 45° wedges, real <text> labels, a fixed pointer at 12 o'clock.
 * Only the rotor rotates. Hidden debug labels (?debug=wedges) show each wedge's index.
 */
import { WEDGES, casinoCopy as C } from '../content/copy/casino';

const CX = 240;
const R = 226;
/** Point at `deg` clockwise from 12 o'clock, radius r. */
const xy = (deg: number, r: number): [string, string] => {
  const a = (deg * Math.PI) / 180;
  return [(CX + r * Math.sin(a)).toFixed(2), (CX - r * Math.cos(a)).toFixed(2)];
};
const pt = (deg: number, r: number) => xy(deg, r).join(' ');
const cls: Record<(typeof WEDGES)[number], string> = {
  RICKROLL: 'w-rick',
  RIP: 'w-rip',
  HYPERLINK: 'w-link',
  'DOUBLE OR NOTHING': 'w-double',
};
const lines = (label: string) =>
  label === 'DOUBLE OR NOTHING' ? ['DOUBLE OR', 'NOTHING'] : [label];
const wedges = WEDGES.map((label, i) => {
  const a0 = i * 45;
  const a1 = a0 + 45;
  return {
    label,
    i,
    mid: a0 + 22.5,
    d: `M ${CX} ${CX} L ${pt(a0, R)} A ${R} ${R} 0 0 1 ${pt(a1, R)} Z`,
    cls: cls[label],
    lines: lines(label),
  };
});
---

<div class="wheel" data-wheel>
  <svg
    class="wheel__pointer"
    viewBox="0 0 40 48"
    width="40"
    height="48"
    role="img"
    aria-label={C.pointerLabel}
  >
    <path d="M4 4 H36 L20 44 Z" />
  </svg>
  <svg
    class="wheel__rotor"
    data-rotor
    viewBox="0 0 480 480"
    width="480"
    height="480"
    role="img"
    aria-label={C.wheelLabel}
  >
    <circle class="wheel__rim" cx={CX} cy={CX} r="236"></circle>
    {wedges.map((w) => (
      <g class={`wedge ${w.cls}`} data-wedge={w.i} data-label={w.label}>
        <path d={w.d} />
        <g transform={`rotate(${w.mid} ${CX} ${CX})`}>
          {w.lines.map((l, k) => (
            <text
              x={CX}
              y={w.lines.length === 1 ? 84 : 76 + k * 22}
              text-anchor="middle"
              class="wedge__text"
            >
              {l}
            </text>
          ))}
          <text x={CX} y="150" text-anchor="middle" class="wheel__debug">
            #{w.i}
          </text>
        </g>
      </g>
    ))}
    {wedges.map((w) => (
      <circle class="wheel__peg" cx={xy(w.i * 45, 220)[0]} cy={xy(w.i * 45, 220)[1]} r="5" />
    ))}
    <circle class="wheel__hub" cx={CX} cy={CX} r="40"></circle>
    <text x={CX} y={CX + 7} text-anchor="middle" class="wheel__hub-text">
      DRV
    </text>
  </svg>
</div>

<style>
  .wheel {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    padding-top: 28px;
  }
  .wheel__rotor {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .wheel__pointer {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    width: 40px;
    height: 48px;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.5));
  }
  .wheel__pointer path {
    fill: var(--gold);
    stroke: #1a1a1a;
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .wheel__rim {
    fill: #1a1a1a;
    stroke: var(--gold);
    stroke-width: 8;
  }
  .wedge path {
    stroke: #1a1a1a;
    stroke-width: 2;
  }
  .w-rick path {
    fill: var(--wedge-rick);
  }
  .w-rip path {
    fill: var(--wedge-rip);
  }
  .w-link path {
    fill: var(--wedge-link);
  }
  .w-double path {
    fill: var(--wedge-double);
  }
  .wedge__text {
    font: 700 19px/1 var(--font-mono);
    letter-spacing: 0.06em;
    fill: #fff;
  }
  .w-link .wedge__text {
    fill: #1a1a1a;
  }
  .wheel__debug {
    display: none;
    font: 700 22px/1 var(--font-mono);
    fill: #fff;
    paint-order: stroke;
    stroke: #000;
    stroke-width: 4px;
  }
  :global(.wheel--debug) .wheel__debug {
    display: inline;
  }
  .wheel__peg {
    fill: var(--gold);
    stroke: #1a1a1a;
    stroke-width: 2;
  }
  .wheel__hub {
    fill: var(--gold);
    stroke: #1a1a1a;
    stroke-width: 4;
  }
  .wheel__hub-text {
    font: 700 20px/1 var(--font-mono);
    letter-spacing: 0.1em;
    fill: #7a1712;
  }
</style>
