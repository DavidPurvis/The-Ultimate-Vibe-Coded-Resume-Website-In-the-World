---
/** The ordinary footer. The form number appears only where the Department operates. */
import { url } from '../lib/paths';

interface Props {
  formNumber?: string;
}
const { formNumber } = Astro.props;
const repo = 'https://github.com/DavidPurvis/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World';
---

<footer class="site-foot">
  <div class="container site-foot__inner">
    <ul class="site-foot__links">
      <li>
        <a href={url('/how-it-was-built/')}>How it was built</a>
      </li>
      <li>
        <a href={url('/credits/')}>Credits</a>
      </li>
      <li>
        <a href={repo} rel="noopener noreferrer">
          Source
        </a>
      </li>
    </ul>
    {formNumber && <p class="fine site-foot__form">{formNumber}</p>}
  </div>
</footer>
