---
/**
 * A parody form that collects nothing. Deliberately NOT a <form>: there is no submit path at all
 * without JavaScript, so answers can't end up in a URL or a server log. autocomplete="off"
 * everywhere, and names that no browser autofill will recognise.
 */
import type { ParodyFormCopy } from '../content/copy/forms';

interface Props {
  form: ParodyFormCopy;
}
const { form: F } = Astro.props;
const fid = (id: string) => `pf-${F.id}-${id}`;
// Question numbers skip 7, which the Department abolished.
const qNumbers = Array.from({ length: F.fields.length + 3 }, (_, i) => i + 1)
  .filter((n) => !String(n).includes('7'))
  .slice(0, F.fields.length);
---

<section
  class="parody-form card"
  role="form"
  aria-labelledby={`${F.id}-title`}
  data-parody-form={F.id}
>
  <h2 class="sr-only" id={`${F.id}-title`}>
    {F.h1}
  </h2>
  <div class="pf__fields" data-pf-fields>
    {F.fields.map((f, i) => (
      <div class="pf__field" data-pf-field={f.id}>
        {f.kind === 'choice' ? (
          <fieldset>
            <legend>
              <span class="pf__n mono">Q{qNumbers[i]}.</span> {f.label}
            </legend>
            <div class="pf__options">
              {f.options.map((o, j) => (
                <label class="pf__option">
                  <input type="radio" name={fid(f.id)} value={String(j)} autocomplete="off" />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ) : (
          <>
            <label for={fid(f.id)} class="pf__label">
              <span class="pf__n mono">Q{qNumbers[i]}.</span> {f.label}
            </label>
            {f.kind === 'text' && (
              <input
                id={fid(f.id)}
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder={f.placeholder}
                aria-describedby={f.hint ? `${fid(f.id)}-hint` : undefined}
              />
            )}
            {f.kind === 'number' && (
              <input
                id={fid(f.id)}
                type="number"
                inputmode="numeric"
                autocomplete="off"
                min={f.min}
                max={f.max}
                aria-describedby={f.hint ? `${fid(f.id)}-hint` : undefined}
              />
            )}
            {f.kind === 'select' && (
              <select id={fid(f.id)} autocomplete="off">
                <option value="">Choose…</option>
                {f.options.map((o, j) => (
                  <option value={String(j)}>{o}</option>
                ))}
              </select>
            )}
            {f.kind === 'range' && (
              <div class="pf__range">
                <input
                  id={fid(f.id)}
                  type="range"
                  min={f.min}
                  max={f.max}
                  value={Math.round((f.min + f.max) / 2)}
                  autocomplete="off"
                />
                <div class="pf__range-labels" aria-hidden="true">
                  <span>{f.minLabel}</span>
                  <span>{f.maxLabel}</span>
                </div>
              </div>
            )}
            {'hint' in f && f.hint && (
              <p class="fine" id={`${fid(f.id)}-hint`}>
                {f.hint}
              </p>
            )}
          </>
        )}
      </div>
    ))}
  </div>
  <p class="pf__actions">
    <button type="button" class="btn btn--primary js-only" data-pf-submit>
      {F.submit}
    </button>
  </p>
  <p class="pf__status fine" data-pf-status role="status"></p>
  <div class="receipt" data-pf-receipt tabindex="-1" hidden>
    <p class="receipt__title">{F.receiptTitle}</p>
    <ul>
      {F.receipt.map((l) => (
        <li>{l}</li>
      ))}
    </ul>
    <button type="button" class="btn btn--small" data-pf-again>
      {F.again}
    </button>
  </div>
  <p class="fine pf__disclaimer">{F.disclaimer}</p>
  <span hidden data-pf-copy={JSON.stringify({ processing: F.processing })}></span>
</section>

<style>
  .parody-form {
    max-width: 44rem;
    padding: clamp(var(--s-4), 3vw, var(--s-6));
  }
  .pf__fields {
    display: grid;
    gap: var(--s-5);
  }
  .pf__field fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .pf__field legend,
  .pf__label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--s-2);
  }
  .pf__n {
    color: var(--stamp);
    font-size: 0.85rem;
  }
  .pf__options {
    display: grid;
    gap: var(--s-1);
  }
  .pf__option {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--target);
    padding: 0 var(--s-2);
    border-radius: var(--r-1);
    cursor: pointer;
  }
  .pf__option:hover {
    background: color-mix(in srgb, var(--action) 8%, transparent);
  }
  .pf__option input {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--action);
  }
  .pf__field input[type='text'],
  .pf__field input[type='number'],
  .pf__field select {
    width: 100%;
    max-width: 28rem;
    min-height: var(--target);
    padding: 0 var(--s-3);
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--ink-2);
    border-radius: var(--r-1);
  }
  .pf__range input {
    width: 100%;
    max-width: 28rem;
    min-height: var(--target);
    accent-color: var(--action);
  }
  .pf__range-labels {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    max-width: 28rem;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .pf__actions {
    margin-top: var(--s-6);
  }
  .pf__status {
    min-height: 1.4em;
  }
  .pf__disclaimer {
    margin-top: var(--s-5);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-3);
  }
</style>
