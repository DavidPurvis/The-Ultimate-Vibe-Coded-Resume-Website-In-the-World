---
/** Native <dialog> shell: visible close button, labelled heading (focusable for step changes). */
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
  closeLabel: string;
  class?: string;
  wide?: boolean;
}
const { id, title, closeLabel, class: className, wide = false } = Astro.props;
---

<dialog
  id={id}
  class:list={['scene-dialog', className, { 'scene-dialog--wide': wide }]}
  aria-labelledby={`${id}-title`}
>
  <div class="scene-dialog__head">
    <h2 id={`${id}-title`} tabindex="-1">
      {title}
    </h2>
    <button type="button" class="icon-btn" data-close aria-label={closeLabel}>
      <Icon name="x" />
    </button>
  </div>
  <div class="scene-dialog__body" id={`${id}-body`}>
    <slot />
  </div>
</dialog>

<style>
  .scene-dialog--wide {
    width: min(100% - 2rem, 56rem);
  }
</style>
