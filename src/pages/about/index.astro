---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FlagCard from '../../components/FlagCard.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES } from '../../content/copy/meta';
import { aboutCopy, appendix, flags } from '../../content/copy/greenFlags';
import { completion } from '../../content/copy/captcha';
import { url } from '../../lib/paths';

// Form sub-numbers skip 07 (see the anti-seven initiative on /beliefs/).
const nums = Array.from({ length: flags.length + appendix.length + 2 }, (_, i) => i + 1).filter(
  (n) => n % 10 !== 7,
);
const fid = (i: number) => `DRV-3/${String(nums[i]).padStart(2, '0')}`;
---

<Base route={ROUTES.about}>
  <div class="receipt skipped-receipt" data-skipped-receipt hidden role="status">
    <p class="receipt__title">CEREMONY SKIPPED</p>
    <ul>
      <li>{completion.skippedReceipt}</li>
    </ul>
  </div>

  <PageHero kicker={aboutCopy.kicker} title={aboutCopy.h1} sub={aboutCopy.sub}>
    <p class="fine mono">{aboutCopy.reviewer}</p>
    <p class="fine">{aboutCopy.stampHint}</p>
  </PageHero>

  <div class="grid flags">
    {flags.map((f, i) => (
      <FlagCard flag={f} formId={fid(i)} />
    ))}
  </div>

  <details class="appendix section" data-appendix>
    <summary>
      <Icon set="game" name="handcuffs" size={28} />
      <span>{aboutCopy.appendixSummary(appendix.length)}</span>
    </summary>
    <p class="appendix__intro">{aboutCopy.appendixIntro}</p>
    <div class="grid flags">
      {appendix.map((f, i) => (
        <FlagCard flag={f} formId={fid(flags.length + i)} appendix />
      ))}
    </div>
  </details>

  <p class="section next-link">
    <a class="btn btn--primary" href={url('/skills/')} data-playful>
      Continue to the Loadout →
    </a>
  </p>
</Base>

<script>
  import '../../scenes/audit';
</script>

<style>
  .flags {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .appendix {
    border: 2px dashed var(--stamp);
    border-radius: var(--r-3);
    padding: var(--s-4) var(--s-5);
  }
  .appendix summary {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--target);
    cursor: pointer;
    font: 600 1.25rem/1.3 var(--font-display);
    color: var(--stamp);
  }
  .appendix__intro {
    margin-top: var(--s-4);
    max-width: var(--prose);
  }
  .skipped-receipt {
    margin-bottom: var(--s-5);
  }
</style>
