---
/**
 * Share decoys. Sincere Open Graph copy from verified facts (so the unfurl is honest), a cover
 * sheet, and a stationary skip link. No redirects, no autoplay, no meta refresh.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Stamp from '../../components/Stamp.astro';
import { DECOYS, type RouteMeta } from '../../content/copy/meta';
import { decoyPage as D } from '../../content/copy/rick';
import { url } from '../../lib/paths';

export function getStaticPaths() {
  return DECOYS.map((d) => ({ params: { slug: d.slug }, props: { decoy: d } }));
}

const { decoy } = Astro.props as { decoy: (typeof DECOYS)[number] };
const route: RouteMeta = {
  path: `/r/${decoy.slug}/`,
  title: `Case File: ${decoy.title} · David Purvis`,
  description: decoy.description,
  formId: `DRV-15/${decoy.n}`,
};
---

<Base route={route} ogTitle={`Case File: ${decoy.title}`}>
  <article class="cover card">
    <p class="kicker">FORM DRV-15 · CASE FILE COVER SHEET</p>
    <h1>{D.heading(decoy.n, decoy.title)}</h1>
    <p class="lede">{decoy.description}</p>
    <p class="cover__stamp">
      <Stamp text="Access restricted" tone="red" rotate={-6} />
    </p>
    <p>{D.body}</p>
    <div class="btn-row">
      <button type="button" class="btn btn--primary" data-rick-begin data-continue={decoy.target}>
        <Icon name="play" />
        {D.begin}
      </button>
      <a class="btn" href={url(decoy.target)}>
        {D.skip}
      </a>
    </div>
  </article>
</Base>

<script>
  import '../../scenes/rickroll/page';
</script>

<style>
  .cover {
    max-width: 44rem;
    margin: var(--s-6) auto;
    padding: var(--s-6);
  }
  .cover__stamp {
    margin: var(--s-4) 0;
  }
</style>
