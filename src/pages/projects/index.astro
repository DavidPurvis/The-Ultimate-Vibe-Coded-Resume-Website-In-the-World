---
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES } from '../../content/copy/meta';
import { caseFiles, projectsCopy as P } from '../../content/copy/projects';
import { identity } from '../../content/identity';
---

<Site route={ROUTES.projects}>
  <PageHero kicker={P.kicker} title={P.h1} sub={P.sub} />

  <div class="projects">
    {caseFiles.map((c) => (
      <article class="card project" id={c.id} aria-labelledby={`${c.id}-h`}>
        <h2 id={`${c.id}-h`}>{c.name}</h2>
        <p class="project__stack">
          <strong>{P.stackLabel}:</strong> {c.stack}
        </p>
        {c.body.map((b) => (
          <p>{b}</p>
        ))}
        {c.knownIssue && (
          <p class="project__issue">
            <Icon name="triangle-alert" />
            <span>
              <strong>{P.knownIssueLabel}:</strong> {c.knownIssue}
            </span>
          </p>
        )}
      </article>
    ))}
  </div>

  <p class="section fine">
    {P.footer}{' '}
    <a href={identity.github.href} rel="noopener noreferrer">
      {identity.github.display}
    </a>
    .
  </p>
</Site>

<style>
  .projects {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 64rem) {
    .projects {
      grid-template-columns: 1fr 1fr;
    }
  }
  .project {
    padding: var(--s-5);
    scroll-margin-top: 6rem;
  }
  .project:target {
    box-shadow:
      0 0 0 3px var(--focus),
      var(--sh-2);
  }
  .project h2 {
    font-size: 1.4rem;
  }
  .project__stack {
    font: 400 0.9rem/1.5 var(--font-mono);
    color: var(--ink-2);
  }
  .project__issue {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    background: var(--warn-bg);
    color: var(--warn-ink);
    border-radius: var(--r-1);
    padding: var(--s-3);
  }
</style>
