---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stamp from '../../components/Stamp.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES } from '../../content/copy/meta';
import {
  aliases,
  credentials as C,
  favoriteFoods,
  goldfishName,
  kidnapInstructions,
  personnelCopy as P,
  r6,
} from '../../content/copy/personnel';
import { shown, shownAll } from '../../content/pending';
import { url } from '../../lib/paths';

const foods = shownAll(favoriteFoods);
const stats = shownAll(r6.stats);
// The Department abolished the number seven; alias numbers skip it too.
const akaNumbers = Array.from({ length: aliases.length + 2 }, (_, i) => i + 1)
  .filter((n) => !String(n).includes('7'))
  .slice(0, aliases.length);
---

<Base route={ROUTES.personnel}>
  <PageHero kicker={P.kicker} title={P.h1} sub={P.sub} />

  <section class="section" aria-labelledby="aliases-h">
    <h2 id="aliases-h">{P.aliasesHeading}</h2>
    <p class="fine">{P.aliasesNote}</p>
    <ul class="aliases" role="list">
      {aliases.map((a, i) => (
        <li class="alias card" data-alias={a.id}>
          <p class="card__form-id">AKA-{String(akaNumbers[i]).padStart(2, '0')}</p>
          <p class="alias__name">{a.name}</p>
          <p class="alias__note">{a.note}</p>
          <p class="alias__origin mono">
            {P.originLabel}: {shown(a.origin) ? a.origin.text : P.originUnknown}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="creds-h">
    <h2 id="creds-h">{P.credentialsHeading}</h2>
    <div class="creds">
      <article class="certificate" aria-labelledby="cert-minister">
        <p class="certificate__kicker">Certificate of Ordination</p>
        <h3 id="cert-minister">{C.minister.title}</h3>
        <p class="certificate__tenure">{C.minister.tenure}</p>
        <p>{C.minister.story}</p>
        <p class="fine">{C.minister.services}</p>
        <Stamp text="Ordained" tone="ink" rotate={-8} />
      </article>
      <article class="certificate certificate--fish" aria-labelledby="cert-fish">
        <p class="certificate__kicker">Aquatic Honors</p>
        <h3 id="cert-fish">
          <Icon set="fluent" name="water-wave" size={28} />
          {C.goldfish.title}
        </h3>
        <p>{C.goldfish.story}</p>
        {shown(goldfishName) && (
          <p class="mono" data-goldfish-name>
            {goldfishName.label}: {goldfishName.text}
          </p>
        )}
        <Stamp text="Swim meet: missed" tone="amber" rotate={5} />
      </article>
    </div>
  </section>

  {foods.length > 0 && (
    <section class="section" aria-labelledby="foods-h" data-foods>
      <h2 id="foods-h">{P.foodsHeading}</h2>
      <p class="fine">{P.foodsNote}</p>
      <ul class="foods">
        {foods.map((f) => (
          <li>{f.text}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="section" aria-labelledby="r6-h">
    <h2 id="r6-h">{P.r6Heading}</h2>
    <div class="r6 card">
      <ul class="r6__mains" role="list">
        {r6.mains.map((m) => (
          <li>
            <p class="r6__op">
              {m.operator} <span class="r6__side mono">{m.side}</span>
            </p>
            <p>{m.role}</p>
          </li>
        ))}
      </ul>
      {stats.length > 0 && (
        <dl class="r6__stats" data-r6-stats>
          {stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.text}</dd>
            </div>
          ))}
        </dl>
      )}
      <p>
        <a href={P.r6ProfileUrl} rel="noopener noreferrer">
          {P.r6Profile}
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="kidnap-h">
    <h2 id="kidnap-h">
      <Icon set="fluent" name="police-car-light" size={32} />
      {P.kidnapHeading}
    </h2>
    <p class="fine">{P.kidnapNote}</p>
    <ol class="kidnap">
      {kidnapInstructions.map((k) => (
        <li>{k.text}</li>
      ))}
    </ol>
  </section>

  <p class="section">
    <a class="btn btn--primary" href={url('/wishlist/')} data-playful>
      {P.wishlistLink}
    </a>
  </p>
</Base>

<style>
  .aliases {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .alias {
    padding: var(--s-4);
    border-left: 6px solid var(--stamp);
  }
  .alias__name {
    font: 700 1.5rem/1.1 var(--font-display);
    margin-bottom: var(--s-2);
  }
  .alias__origin {
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 0;
  }
  .creds {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .certificate {
    position: relative;
    padding: var(--s-5);
    background: var(--card);
    border: 6px double color-mix(in srgb, var(--gold) 70%, var(--ink));
    border-radius: var(--r-1);
    text-align: center;
  }
  .certificate__kicker {
    font: 600 0.8rem/1 var(--font-mono);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .certificate h3 {
    display: flex;
    gap: var(--s-2);
    justify-content: center;
    align-items: center;
    font-family: var(--font-display);
    font-size: 1.6rem;
  }
  .certificate__tenure {
    font-style: italic;
  }
  .r6 {
    padding: var(--s-5);
  }
  .r6__mains {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .r6__op {
    font: 700 1.3rem/1.2 var(--font-display);
    margin-bottom: var(--s-1);
  }
  .r6__side {
    font-size: 0.75rem;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .r6__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .r6__stats dt {
    font: 600 0.75rem var(--font-mono);
    color: var(--ink-2);
  }
  .r6__stats dd {
    margin: 0;
    font: 700 1.4rem var(--font-display);
  }
  .kidnap {
    max-width: 42rem;
    display: grid;
    gap: var(--s-2);
  }
  .kidnap li::marker {
    font-weight: 700;
    color: var(--stamp);
  }
  #kidnap-h {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
</style>
