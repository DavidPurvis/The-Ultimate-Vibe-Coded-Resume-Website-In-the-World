---
import Resume from '../../layouts/Resume.astro';
import ResumeDocument from '../../components/ResumeDocument.astro';
import Icon from '../../components/Icon.astro';
import LaneSwitcher from '../../components/LaneSwitcher.astro';
import '../../styles/resume.css';
import { ROUTES } from '../../content/copy/meta';
import { resumeTools } from '../../content/copy/resumeExtras';
import { identity } from '../../content/resume';
import { absoluteUrl, entityEncode, url } from '../../lib/paths';

const mailto = `mailto:${identity.email}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: identity.headline,
  url: absoluteUrl('/resume/', Astro.site),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Broomfield',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  sameAs: [identity.linkedin.href, identity.github.href],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Mississippi State University' },
    { '@type': 'CollegeOrUniversity', name: 'University of Colorado Boulder' },
  ],
};
---

<Resume route={ROUTES.resume}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="resume-page">
    <div class="resume-sheet">
      <ResumeDocument />
    </div>
    <div class="resume-tools screen-only" role="group" aria-label={resumeTools.sectionLabel}>
      <a class="btn btn--primary" href={url('/resume.pdf')} download="David-Purvis-Resume.pdf">
        <Icon name="download" />
        {resumeTools.download}
      </a>
      <button type="button" class="btn js-only" data-print>
        <Icon name="printer" />
        {resumeTools.print}
      </button>
      <Fragment
        set:html={`<a class="btn" href="${entityEncode(mailto)}">${resumeTools.email}</a>`}
      />
    </div>
    <LaneSwitcher current="gen" />
  </div>
</Resume>

<script>
  import '../../scripts/resume-page';
</script>
