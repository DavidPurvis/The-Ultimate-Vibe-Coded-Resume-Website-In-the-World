---
import Resume from '../../layouts/Resume.astro';
import ResumeDocument from '../../components/ResumeDocument.astro';
import SceneDialog from '../../components/SceneDialog.astro';
import Icon from '../../components/Icon.astro';
import Memo from '../../components/Memo.astro';
import LaneSwitcher from '../../components/LaneSwitcher.astro';
import '../../styles/resume.css';
import { ROUTES } from '../../content/copy/meta';
import { hireChain, resumeTools } from '../../content/copy/resumeExtras';
import { recruiterBar } from '../../content/copy/global';
import { memos } from '../../content/copy/memos';
import { identity } from '../../content/resume';
import { absoluteUrl, entityEncode, url } from '../../lib/paths';

const mailto = `mailto:${identity.email}?subject=${encodeURIComponent(hireChain.subject)}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: identity.headline,
  url: absoluteUrl('/resume/', Astro.site),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Broomfield',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  sameAs: [identity.linkedin.href, identity.github.href],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Mississippi State University' },
    { '@type': 'CollegeOrUniversity', name: 'University of Colorado Boulder' },
  ],
};
---

<Resume route={ROUTES.resume}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="recruiter-bar recruiter-only screen-only" slot="top">
    <div class="container">
      <span>{recruiterBar.text}</span>
      <button type="button" class="btn btn--small" data-reenable-chaos>
        {recruiterBar.button}
      </button>
    </div>
  </div>

  <div class="resume-page">
    <div class="resume-sheet">
      <ResumeDocument />
    </div>
    <div class="resume-tools screen-only" role="group" aria-label={resumeTools.sectionLabel}>
      <a class="btn btn--primary" href={url('/resume.pdf')} download="David-Purvis-Resume.pdf">
        <Icon name="download" />
        {resumeTools.download}
      </a>
      <button type="button" class="btn" data-print>
        <Icon name="printer" />
        {resumeTools.print}
      </button>
      <button type="button" class="btn" data-hire>
        <Icon set="fluent" name="crossed-fingers" />
        {resumeTools.hire}
      </button>
    </div>
    <p class="fine resume-fine screen-only">{resumeTools.fine}</p>
    <LaneSwitcher current="gen" />
  </div>

  <SceneDialog id="hire" title={hireChain.steps[0]?.title ?? ''} closeLabel={hireChain.closeLabel}>
    {hireChain.steps.map((s, i) => (
      <div class="hire-step" data-step={i} hidden={i !== 0}>
        <p>{s.body}</p>
        <div class="btn-row">
          <button type="button" class="btn btn--primary" data-yes>
            {s.yes}
          </button>
          <button type="button" class="btn" data-no>
            {s.no}
          </button>
        </div>
      </div>
    ))}
    <div class="hire-step" data-step="final" hidden>
      <p class="fine">{hireChain.final.fine}</p>
      <Fragment
        set:html={`<a class="btn btn--primary" data-hire-mail href="${entityEncode(mailto)}">${hireChain.final.button}</a>`}
      />
    </div>
    <div class="hire-step" data-step="declined" hidden>
      <p>{hireChain.declined}</p>
      <button type="button" class="btn" data-close>
        Close
      </button>
    </div>
    <span
      hidden
      data-hire-copy={JSON.stringify({
        steps: hireChain.steps.map((s) => s.title),
        final: hireChain.final.title,
        consulting: hireChain.consulting,
        declined: hireChain.declined,
      })}
    ></span>
  </SceneDialog>

  <Memo text={memos.resume} />
</Resume>

<script>
  import '../../scripts/resume-page';
</script>
