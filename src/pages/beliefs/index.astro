---
import Base from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES } from '../../content/site/meta';
import { beliefsCopy as B, papers, positions } from '../../content/copy/beliefs';

const outside = positions.filter((p) => !p.upsideDown);
const inside = positions.filter((p) => p.upsideDown);
---

<Base route={ROUTES.beliefs}>
  <PageHero kicker={B.kicker} title={B.h1} sub={B.sub}>
    <p class="real-error disclaimer">
      <Icon name="info" />
      <span>{B.disclaimer}</span>
    </p>
  </PageHero>

  <section aria-labelledby="positions-h">
    <h2 id="positions-h">{B.positionsHeading}</h2>
    <ol class="positions">
      {outside.map((p) => (
        <li value={p.n}>
          {p.icon && <Icon set="fluent" name={p.icon} size={28} />}
          <span>{p.text}</span>
        </li>
      ))}
    </ol>

    <section class="upside" tabindex="0" aria-labelledby="upside-h" data-upside>
      <p id="upside-h" class="upside__label" data-upside-label>
        {B.upsideLabel}
      </p>
      <p class="upside__disabled fine" data-upside-disabled hidden>
        {B.upsideDisabled}
      </p>
      <ol class="positions upside__list">
        {inside.map((p) => (
          <li value={p.n}>
            {p.icon && <Icon set="fluent" name={p.icon} size={28} />}
            <span>{p.text}</span>
          </li>
        ))}
      </ol>
      <div class="upside__filler" aria-hidden="true">
        {Array.from({ length: 10 }, (_, i) => (
          <p>
            ↕ {i % 2 ? 'Keep scrolling. Or don’t. Down is up here.' : 'The Upside Down continues.'}
          </p>
        ))}
      </div>
    </section>
    <p class="fine seven">{B.sevenObjection}</p>
  </section>

  <section class="section" aria-labelledby="papers-h">
    <h2 id="papers-h">{B.papersHeading}</h2>
    <div class="papers">
      {papers.map((p) => (
        <article class:list={['card', 'paper', { 'paper--bug': p.bugReport }]} id={`paper-${p.id}`}>
          <p class="card__form-id">{p.code}</p>
          <h3>
            {p.icon && <Icon set="fluent" name={p.icon} size={28} />}
            {p.title}
          </h3>
          <dl>
            {p.sections.map((s) => (
              <>
                <dt>{s.heading}</dt>
                <dd>{s.body}</dd>
              </>
            ))}
          </dl>
          {p.aside && (
            <aside class="paper__aside">
              <p class="kicker">{p.aside.heading}</p>
              <p>{p.aside.body}</p>
            </aside>
          )}
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  import '../../scenes/upside-down';
</script>

<style>
  .disclaimer {
    max-width: var(--prose);
  }
  .disclaimer :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 2px;
  }
  .positions {
    display: grid;
    gap: var(--s-3);
    padding-left: 2.5rem;
    max-width: 52rem;
  }
  .positions li {
    padding-left: var(--s-2);
  }
  .positions li::marker {
    font: 700 1rem var(--font-mono);
    color: var(--stamp);
  }
  .positions li :global(svg) {
    vertical-align: middle;
    margin-right: var(--s-2);
  }
  .upside {
    margin: var(--s-5) 0 var(--s-2);
    height: 320px;
    overflow: auto;
    border: 3px dashed var(--stamp);
    border-radius: var(--r-2);
    padding: var(--s-4);
    background: color-mix(in srgb, var(--warn-bg) 50%, var(--card));
    max-width: 52rem;
  }
  .upside__label {
    position: sticky;
    top: calc(var(--s-4) * -1);
    background: var(--warn-bg);
    color: var(--warn-ink);
    font: 600 0.85rem/1.4 var(--font-mono);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-1);
    z-index: 1;
  }
  .upside__filler p {
    color: var(--ink-2);
    font-style: italic;
  }
  .seven {
    font-family: var(--font-mono);
  }
  .papers {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }
  .paper h3 {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .paper dl {
    margin: 0;
  }
  .paper dt {
    font: 600 0.8rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    margin-top: var(--s-3);
  }
  .paper dd {
    margin: var(--s-1) 0 0;
  }
  .paper--bug {
    border-left: 6px solid var(--stamp);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .paper__aside {
    margin-top: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-left: 4px solid var(--ok);
    background: color-mix(in srgb, var(--ok) 8%, var(--card));
  }
  .paper__aside p {
    margin: 0;
  }
</style>
