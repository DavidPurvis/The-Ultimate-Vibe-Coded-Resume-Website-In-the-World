---
import Base from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import ParodyForm from '../../components/ParodyForm.astro';
import { ROUTES } from '../../content/site/meta';
import { confess as F } from '../../content/copy/forms';
---

<Base route={ROUTES.confess}>
  <PageHero kicker={F.kicker} title={F.h1} lede={F.lede} />
  {F.callout && <p class="callout card">{F.callout}</p>}
  <ParodyForm form={F} />
</Base>

<script>
  import '../../scenes/parody-form';
</script>

<style>
  .callout {
    max-width: 44rem;
    padding: var(--s-3) var(--s-4);
    border-left: 6px solid var(--ok);
    margin-bottom: var(--s-5);
    font-weight: 600;
  }
</style>
