---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Stamp from '../../components/Stamp.astro';
import { ROUTES } from '../../content/copy/meta';
import { matrix, rafting, skillsCopy as S, skins, type Rarity } from '../../content/copy/skills';
import { url } from '../../lib/paths';

const order: Rarity[] = ['covert', 'classified', 'restricted', 'consumer', 'souvenir'];
---

<Base route={ROUTES.skills}>
  <PageHero kicker={S.kicker} title={S.h1} sub={S.sub} />

  <div class="legend card">
    <p>{S.legend}</p>
    <ul class="legend__list">
      {order.map((r) => (
        <li>
          <span class:list={['rarity-chip', `rarity--${r}`]}>{S.rarities[r].label}</span> ={' '}
          {S.rarities[r].meaning}
        </li>
      ))}
    </ul>
  </div>

  <ul class="skins section" role="list">
    {skins.map((k, i) => (
      <li class:list={['skin', `rarity--${k.rarity}`]} data-skin>
        <div class="skin__face" data-face="front">
          <Icon set="game" name="crosshair" size={28} />
          <p class="skin__name">
            {k.name} <span class="skin__wear">| {k.wear}</span>
          </p>
          <p class="skin__float mono">Float {k.float.toFixed(4)}</p>
          {k.statTrak && <p class="skin__stat mono">{k.statTrak}</p>}
        </div>
        {k.evidence && (
          <div class="skin__face skin__back" data-face="back" id={`skin-${i}`}>
            <p class="kicker">{S.evidenceLabel}</p>
            <p>{k.evidence}</p>
          </div>
        )}
        {k.evidence && (
          <button
            type="button"
            class="btn btn--small skin__inspect"
            aria-expanded="true"
            aria-controls={`skin-${i}`}
            data-inspect
            data-open-label={S.inspectBack}
            data-closed-label={S.inspect}
          >
            <Icon name="eye" />
            <span>{S.inspect}</span>
          </button>
        )}
      </li>
    ))}
  </ul>

  <section class="section">
    <table class="matrix">
      <caption>{S.matrixCaption}</caption>
      <thead>
        <tr>
          {S.matrixCols.map((c) => (
            <th scope="col">{c}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {matrix.map((row) => (
          <tr>
            <th scope="row">{row.discipline}</th>
            <td>
              {row.record.text} <span class="mono fine">({row.record.blockRefs?.join(', ')})</span>
            </td>
            <td>
              {row.liability.text}{' '}
              {row.liability.status === 'fictional' && (
                <Stamp text={S.fabricated} tone="red" rotate={-3} />
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section">
    <h2>
      <Icon set="game" name="paddles" size={32} />
      {S.raftingCaption}
    </h2>
    <ul class="rafting" role="list">
      {rafting.map((r) => (
        <li>{r.text}</li>
      ))}
    </ul>
  </section>

  <p class="section">
    <a class="btn btn--primary" href={url('/beliefs/')} data-playful>
      Continue to the Research Institute →
    </a>
  </p>
</Base>

<script>
  import '../../scenes/loadout';
</script>

<style>
  .legend__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .rarity-chip {
    font: 600 0.8rem var(--font-mono);
    padding: 0.15em 0.6em;
    border-radius: var(--r-pill);
    color: #fff;
    background: var(--rarity);
  }
  .rarity--covert {
    --rarity: #b3261e;
  }
  .rarity--classified {
    --rarity: #b0247f;
  }
  .rarity--restricted {
    --rarity: #6d28d9;
  }
  .rarity--consumer {
    --rarity: #5b6472;
  }
  .rarity--souvenir {
    --rarity: #8a6d0b;
  }
  .skins {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .skin {
    position: relative;
    background: linear-gradient(160deg, #1b2230, #2a3346);
    color: #eef1f6;
    border-radius: var(--r-2);
    border-bottom: 6px solid var(--rarity);
    padding: var(--s-4);
    min-height: 11rem;
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }
  .skin :global(svg) {
    color: var(--rarity);
    filter: brightness(1.6);
  }
  .skin__name {
    font: 600 1.05rem/1.3 var(--font-body);
    margin: 0;
  }
  .skin__wear {
    font-weight: 400;
    color: #c9d1dc;
  }
  .skin__float,
  .skin__stat {
    margin: 0;
    font-size: 0.8rem;
    color: #c9d1dc;
  }
  .skin__back {
    background: rgb(255 255 255 / 0.06);
    border-radius: var(--r-1);
    padding: var(--s-2) var(--s-3);
  }
  .skin__back .kicker {
    color: #c9d1dc;
  }
  .skin__back p {
    margin: 0;
  }
  .skin__inspect {
    justify-self: start;
    --btn-bg: transparent;
    --btn-ink: #eef1f6;
    --btn-border: #8792a2;
  }
  .matrix td,
  .matrix th {
    padding: var(--s-3);
  }
  .matrix :global(.stamp) {
    margin-left: var(--s-2);
  }
  .rafting {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .rafting li {
    padding: var(--s-3) var(--s-4);
    border-left: 4px solid var(--action);
    background: var(--card);
    border-radius: 0 var(--r-1) var(--r-1) 0;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  @media (max-width: 48rem) {
    .matrix,
    .matrix tbody,
    .matrix tr,
    .matrix td,
    .matrix th {
      display: block;
    }
    .matrix thead {
      display: none;
    }
    .matrix tr {
      border-bottom: 2px solid var(--rule);
      padding: var(--s-2) 0;
    }
  }
</style>
