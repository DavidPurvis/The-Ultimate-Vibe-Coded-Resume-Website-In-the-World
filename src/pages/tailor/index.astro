---
/**
 * Résumé For You™ (DDP-26). A local-only quiz: it picks one of the verified lane cuts and builds a
 * claude.ai link the visitor may press. Not a <form>, nothing stored, nothing sent by this page.
 */
import Base from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import { ROUTES } from '../../content/site/meta';
import { tailorCopy as T } from '../../content/copy/tailor';
import { laneCopy } from '../../content/site/resumeExtras';
import { LANE_IDS, LANES } from '../../content/resume/resolve';
import { renderResumeText } from '../../lib/resumeText';
import { absoluteUrl, url } from '../../lib/paths';
import { JD_MAX } from '../../scenes/tailor/logic';

const questions = [T.family, T.focus, T.summary] as const;
const names = ['family', 'focus', 'summary'] as const;
const data = {
  lanes: Object.fromEntries(
    LANE_IDS.map((id) => {
      const lane = LANES[id];
      return [
        id,
        {
          label: lane.label,
          url: absoluteUrl(lane.path, Astro.site),
          text: renderResumeText(lane),
          href: url(lane.path),
          pdf: url(`/${lane.pdf}`),
          pdfName: lane.pdfName,
          cut: T.result.cut(lane.label),
          why: T.result.why[id],
        },
      ];
    }),
  ),
  labels: {
    family: Object.fromEntries(T.family.options.map((o) => [o.value, o.label])),
    focus: Object.fromEntries(T.focus.options.map((o) => [o.value, o.label])),
  },
  fan: T.result.fan,
  aliases: T.alias.options.map((a, i) => (i === 0 ? '' : T.result.alias(a))),
  processing: T.processing,
  counter: T.jd.counter('{n}', JD_MAX.toLocaleString('en-US')),
};
---

<Base route={ROUTES.tailor}>
  <PageHero kicker={T.kicker} title={T.h1} lede={T.lede} />

  <nav class="tailor-skip" aria-label={laneCopy.switcherLabel}>
    <span>{T.skip}</span>
    <ul>
      {LANE_IDS.map((id) => (
        <li>
          <a href={url(LANES[id].path)}>{laneCopy.names[id]}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="tailor card" role="form" aria-labelledby="tailor-title" data-tailor>
    <h2 class="sr-only" id="tailor-title">
      {T.h1}
    </h2>
    <div class="tq__fields">
      {questions.map((q, i) => (
        <fieldset class="tq__field">
          <legend>
            <span class="tq__n mono">Q{i + 1}.</span> {q.label}
          </legend>
          <div class="tq__options">
            {q.options.map((o) => (
              <label class="tq__option">
                <input type="radio" name={`tq-${names[i]}`} value={o.value} autocomplete="off" />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="tq__field">
        <label class="tq__label" for="tq-jd">
          <span class="tq__n mono">Q4.</span>
          {T.jd.label}
        </label>
        <textarea
          id="tq-jd"
          rows="6"
          maxlength={JD_MAX}
          autocomplete="off"
          spellcheck="false"
          aria-describedby="tq-jd-hint"
          data-tq-jd
        ></textarea>
        <p class="fine" id="tq-jd-hint">
          {T.jd.hint}
        </p>
        <p class="fine js-only" data-tq-counter>
          {T.jd.counter('0', JD_MAX.toLocaleString('en-US'))}
        </p>
      </div>
      <div class="tq__field chaos-only">
        <label class="tq__label" for="tq-alias">
          <span class="tq__n mono">Q5.</span>
          {T.alias.label}
        </label>
        <select id="tq-alias" autocomplete="off" data-tq-alias>
          {T.alias.options.map((o, i) => (
            <option value={String(i)}>{o}</option>
          ))}
        </select>
      </div>
    </div>
    <p class="tq__actions">
      <button type="button" class="btn btn--primary js-only" data-tq-assemble>
        {T.assemble}
      </button>
    </p>
    <p class="fine tq__status" role="status" data-tq-status></p>
  </section>

  <section
    class="tailor-result card"
    aria-labelledby="tailor-result-title"
    tabindex="-1"
    hidden
    data-tailor-result
  >
    <h2 id="tailor-result-title">{T.result.title}</h2>
    <p class="tailor-result__cut" data-tr-cut></p>
    <p data-tr-why></p>
    <p class="chaos-only" data-tr-alias hidden></p>
    <div class="btn-row">
      <a class="btn btn--primary" href={url('/resume/')} data-tr-view>
        {T.result.view}
      </a>
      <a class="btn" href={url('/resume.pdf')} download="David-Purvis-Resume.pdf" data-tr-pdf>
        {T.result.pdf}
      </a>
    </div>
    <div class="tailor-claude">
      <h3>{T.claude.heading}</h3>
      <p>{T.claude.body}</p>
      <p>
        <a
          class="btn"
          href="https://claude.ai/new"
          target="_blank"
          rel="noopener noreferrer"
          data-tr-claude
        >
          {T.claude.link}
          <span class="sr-only">{T.claude.newTab}</span>
        </a>
      </p>
      <p class="fine" data-tr-truncated hidden>
        {T.claude.truncated}
      </p>
      <label class="tq__label" for="tq-prompt">
        {T.claude.promptLabel}
      </label>
      <textarea id="tq-prompt" rows="10" readonly spellcheck="false" data-tr-prompt></textarea>
    </div>
  </section>

  <p class="fine tailor-disclaimer">{T.disclaimer}</p>
  <span hidden data-tailor-data={JSON.stringify(data)}></span>
</Base>

<script>
  import '../../scenes/tailor';
</script>

<style>
  .tailor-skip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-bottom: var(--s-5);
  }
  .tailor-skip ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tailor-skip a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--s-3);
    border: 1px solid currentColor;
    border-radius: var(--r-1);
  }
  .tailor,
  .tailor-result {
    max-width: 44rem;
    padding: clamp(var(--s-4), 3vw, var(--s-6));
  }
  .tailor-result {
    margin-top: var(--s-5);
    border-left: 6px solid var(--ok);
  }
  .tq__fields {
    display: grid;
    gap: var(--s-5);
  }
  .tq__field {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .tq__field legend,
  .tq__label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--s-2);
  }
  .tq__n {
    color: var(--stamp);
    font-size: 0.85rem;
  }
  .tq__options {
    display: grid;
    gap: var(--s-1);
  }
  .tq__option {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--target);
    padding: 0 var(--s-2);
    border-radius: var(--r-1);
    cursor: pointer;
  }
  .tq__option:hover {
    background: color-mix(in srgb, var(--action) 8%, transparent);
  }
  .tq__option input {
    width: 1.2rem;
    height: 1.2rem;
    flex: none;
    accent-color: var(--action);
  }
  textarea,
  select {
    display: block;
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--ink-2);
    border-radius: var(--r-1);
  }
  textarea {
    padding: var(--s-2) var(--s-3);
    resize: vertical;
  }
  select {
    max-width: 28rem;
    min-height: var(--target);
    padding: 0 var(--s-3);
  }
  #tq-prompt {
    font: 0.8rem/1.45 var(--font-mono);
    background: color-mix(in srgb, var(--ink) 4%, var(--paper));
  }
  .tq__actions {
    margin-top: var(--s-6);
  }
  .tq__status {
    min-height: 1.4em;
  }
  .tailor-result__cut {
    font: 700 1.2rem/1.3 var(--font-display);
  }
  .tailor-claude {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .tailor-disclaimer {
    max-width: 44rem;
    margin-top: var(--s-5);
  }
</style>
