---
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import { ROUTES } from '../../content/site/meta';
import { colophonCopy as H, colophonSections } from '../../content/site/colophon';
import { url } from '../../lib/paths';

const repo = 'https://github.com/DavidPurvis/The-Ultimate-Vibe-Coded-Resume-Website-In-the-World';
---

<Site route={ROUTES.howBuilt}>
  <PageHero kicker={H.kicker} title={H.h1} lede={H.lede} />

  <nav class="toc card" aria-label="Sections">
    <ol>
      {colophonSections.map((s) => (
        <li>
          <a href={`#${s.id}`}>{s.title}</a>
        </li>
      ))}
      <li>
        <a href="#limitations">{H.limitationsHeading}</a>
      </li>
    </ol>
  </nav>

  <div class="prose">
    {colophonSections.map((s) => (
      <section id={s.id} aria-labelledby={`${s.id}-h`} class="disclosure">
        <h2 id={`${s.id}-h`}>{s.title}</h2>
        {s.body.map((p) => (
          <p>{p}</p>
        ))}
        <p class="limitation">
          <strong>{H.limitationLabel}:</strong> {s.limitation}
        </p>
      </section>
    ))}

    <section id="limitations" aria-labelledby="limitations-h" class="disclosure">
      <h2 id="limitations-h">{H.limitationsHeading}</h2>
      <ul>
        {colophonSections.map((s) => (
          <li>{s.limitation}</li>
        ))}
      </ul>
    </section>

    <ul class="section colophon-links">
      <li>
        <a href={repo} rel="noopener noreferrer">
          {H.repoLink}
        </a>
      </li>
      <li>
        <a href={url('/privacy/')}>{H.privacyLink}</a>
      </li>
      <li>
        <a href={url('/credits/')}>{H.creditsLink}</a>
      </li>
    </ul>
    <p>
      {H.doom} <a href={url('/doom/')}>{H.doomLink}</a>.
    </p>
    <p>
      {H.tribute} <a href={url('/tribute/')}>{H.tributeLink}</a>.
    </p>
  </div>
</Site>

<style>
  .toc {
    padding: var(--s-4) var(--s-5);
    margin-bottom: var(--s-6);
    max-width: 42rem;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.4rem;
    columns: 2 16rem;
  }
  .toc li {
    break-inside: avoid;
    padding: var(--s-1) 0;
  }
  .prose {
    max-width: 42rem;
  }
  .disclosure {
    margin-bottom: var(--s-7);
    scroll-margin-top: 6rem;
  }
  .limitation {
    border-left: 4px solid var(--rule);
    background: var(--card);
    padding: var(--s-3) var(--s-4);
    border-radius: 0 var(--r-1) var(--r-1) 0;
  }
  .colophon-links {
    padding-left: 1.2em;
  }
  .colophon-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
</style>
