---
import Base from '../../layouts/Site.astro';
import { ROUTES } from '../../content/site/meta';
import { nintendoCopy as N } from '../../content/copy/nintendo';
---

<Base route={ROUTES.nintendo}>
  <article class="letter" aria-labelledby="letter-h">
    <p class="kicker">{N.kicker}</p>
    <h1 id="letter-h">{N.h1}</h1>
    <p class="letter__salutation">{N.salutation}</p>
    {N.body.map((p) => (
      <p>{p}</p>
    ))}

    <h2>{N.notHereHeading}</h2>
    <ul class="letter__list">
      {N.notHere.map((x) => (
        <li>{x}</li>
      ))}
    </ul>

    <h2>{N.hereHeading}</h2>
    <ul class="letter__list">
      {N.here.map((x) => (
        <li>{x}</li>
      ))}
    </ul>

    <h2>{N.settlementHeading}</h2>
    <p>{N.settlement}</p>

    <p class="letter__signoff">{N.signoff}</p>
    <p class="letter__signature">{N.signature}</p>

    <div class="letter__action">
      <button type="button" class="btn btn--primary" data-no-sue>
        {N.button}
      </button>
      <div class="receipt" role="status" data-no-sue-receipt hidden>
        <p class="receipt__title">{N.receiptTitle}</p>
        <ul>
          {N.receipt.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      </div>
    </div>

    <p class="fine letter__disclaimer">{N.disclaimer}</p>
  </article>
</Base>

<script>
  import '../../scenes/nintendo';
</script>

<style>
  .letter {
    max-width: 42rem;
    margin: var(--s-4) auto;
    padding: clamp(var(--s-4), 4vw, var(--s-7));
    background: var(--card);
    border: 1px solid var(--rule);
    box-shadow: var(--sh-2);
    border-radius: var(--r-1);
  }
  .letter h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .letter h2 {
    font-size: 1.2rem;
    margin-top: var(--s-5);
  }
  .letter__salutation,
  .letter__signoff {
    font-style: italic;
  }
  .letter__signature {
    font:
      400 2rem/1 'Comic Sans MS',
      'Comic Neue',
      cursive;
    transform: rotate(-3deg);
    margin: var(--s-2) 0 var(--s-6);
  }
  .letter__list li + li {
    margin-top: var(--s-1);
  }
  .letter__action {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .letter__disclaimer {
    margin-top: var(--s-6);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-3);
  }
</style>
