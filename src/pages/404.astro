---
import Site from '../layouts/Site.astro';
import { ROUTES } from '../content/copy/meta';
import { notFoundCopy as N } from '../content/site/errors';
import { url } from '../lib/paths';
---

<Site route={ROUTES.notFound} noindex>
  <div class="nf card">
    <p class="kicker">{N.kicker}</p>
    <h1>{N.h1}</h1>
    <p class="lede">{N.body}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={url('/resume/')}>
        {N.resume}
      </a>
      <a class="btn" href={url('/')}>
        {N.home}
      </a>
    </div>
  </div>
</Site>

<style>
  .nf {
    max-width: 44rem;
    margin: var(--s-7) auto;
    padding: var(--s-6);
  }
  .nf h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }
</style>
