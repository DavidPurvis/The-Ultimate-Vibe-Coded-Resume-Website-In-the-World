---
/** Source for og.png (rendered by scripts/rasterize.ts). Not linked anywhere; noindex. */
import '../styles/fonts';
import '../styles/tokens.css';
import { url } from '../lib/paths';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="card">
      <p class="kicker">DEPARTMENT OF DAVID PURVIS · FORM DDP-1</p>
      <h1>David Purvis</h1>
      <p class="role">Software Engineer · Broomfield, CO</p>
      <p class="line">Public access to information concerning David Purvis.</p>
      <div class="stamp">
        <img src={url('/illustrations/stamp-ring.svg')} alt="" width="270" height="270" />
        <span>
          UNDER
          <br />
          REVIEW
        </span>
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  body {
    background: #f6f1e7 url('/illustrations/paper-noise.svg');
    color: #14213d;
    font-family: var(--font-body);
  }
  .card {
    position: relative;
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 80px 90px;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 28px;
    border: 2px solid #c9bda3;
    border-radius: 14px;
    pointer-events: none;
  }
  .kicker {
    font: 600 22px/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    color: #44506b;
    margin: 0 0 28px;
  }
  h1 {
    font: 700 118px/1 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }
  .role {
    font: 400 38px/1.2 var(--font-body);
    color: #44506b;
    margin: 0 0 56px;
  }
  .line {
    max-width: 720px;
    font: italic 600 48px/1.2 var(--font-display);
    color: #0b6b6b;
    margin: 0;
  }
  .stamp {
    position: absolute;
    right: 70px;
    top: 190px;
    width: 270px;
    height: 270px;
    transform: rotate(-14deg);
    display: grid;
    place-items: center;
    mix-blend-mode: multiply;
  }
  .stamp img {
    position: absolute;
    inset: 0;
  }
  .stamp span {
    font: 700 46px/1.05 var(--font-mono);
    letter-spacing: 0.08em;
    text-align: center;
    color: #a8201a;
  }
</style>
