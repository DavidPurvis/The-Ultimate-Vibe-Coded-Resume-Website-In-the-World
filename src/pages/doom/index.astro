---
/** DRV-24: DOOM, embedded. The engine downloads (from this site) only after Play. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DoomPlayer from '../../components/DoomPlayer.astro';
import '../../styles/doom.css';
import { ROUTES } from '../../content/copy/meta';
import { doomCopy as C } from '../../content/copy/doom';
import { url } from '../../lib/paths';
---

<Base route={ROUTES.doom}>
  <PageHero kicker={C.kicker} title={C.h1} lede={C.lede} />

  <div class="doom-page chaos-only" data-doom-page>
    <DoomPlayer />
  </div>
  <p class="callout card recruiter-only">
    DOOM is paused while HR is in the building. The demons will be here when they leave.
  </p>

  <section class="doom-specs card" aria-labelledby="doom-specs">
    <h2 id="doom-specs">{C.specsTitle}</h2>
    <dl>
      {C.specs.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
    <p class="fine">
      <a href="https://github.com/cloudflare/doom-wasm" rel="noopener noreferrer">
        {C.source}
      </a>
      ·{' '}
      <a href="https://github.com/chocolate-doom/chocolate-doom" rel="noopener noreferrer">
        Chocolate Doom
      </a>{' '}
      · <a href={url('/credits/')}>Credits</a>
    </p>
  </section>

  <p class="doom-note">
    {C.sueLine} <a href={url('/nintendo/')}>{C.sueLink}</a>.
  </p>
  <p class="doom-note">
    {C.tribute} <a href={url('/tribute/')}>{C.tributeLink}</a>.
  </p>
</Base>

<script>
  import '../../scenes/doom/page';
</script>

<style>
  .doom-page {
    max-width: 60rem;
  }
  .callout {
    max-width: 44rem;
    padding: var(--s-3) var(--s-4);
  }
  .doom-specs {
    max-width: 44rem;
    margin-top: var(--s-6);
    padding: var(--s-4) var(--s-5);
  }
  .doom-specs dl {
    display: grid;
    gap: var(--s-2);
    margin: 0 0 var(--s-3);
  }
  .doom-specs dl > div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--s-3);
  }
  .doom-specs dt {
    font: 600 0.8rem/1.5 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .doom-specs dd {
    margin: 0;
  }
  .doom-note {
    max-width: 44rem;
    margin-top: var(--s-4);
  }
</style>
