---
/** DOOM, embedded (an optional enclave, linked from the colophon). Downloads only after Play. */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import DoomPlayer from '../../components/DoomPlayer.astro';
import '../../styles/doom.css';
import { ROUTES } from '../../content/copy/meta';
import { doomCopy as C } from '../../content/site/doom';
import { url } from '../../lib/paths';
---

<Site route={ROUTES.doom}>
  <PageHero kicker={C.kicker} title={C.h1} lede={C.lede} />

  <div class="doom-page" data-doom-page>
    <DoomPlayer />
  </div>

  <section class="doom-specs card" aria-labelledby="doom-specs">
    <h2 id="doom-specs">{C.specsTitle}</h2>
    <dl>
      {C.specs.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
    <p class="fine">
      <a href="https://github.com/cloudflare/doom-wasm" rel="noopener noreferrer">
        {C.source}
      </a>
      ·{' '}
      <a href="https://github.com/chocolate-doom/chocolate-doom" rel="noopener noreferrer">
        Chocolate Doom
      </a>{' '}
      · <a href={url('/credits/')}>Credits</a>
    </p>
  </section>

  <p class="doom-note">{C.sueLine}</p>
  <p class="doom-note">
    {C.tribute} <a href={url('/tribute/')}>{C.tributeLink}</a>.
  </p>
</Site>

<script>
  import '../../scripts/doom-page';
</script>

<style>
  .doom-page {
    max-width: 60rem;
  }
  .doom-specs {
    max-width: 44rem;
    margin-top: var(--s-6);
    padding: var(--s-4) var(--s-5);
  }
  .doom-specs dl {
    display: grid;
    gap: var(--s-2);
    margin: 0 0 var(--s-3);
  }
  .doom-specs dl > div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--s-3);
  }
  .doom-specs dt {
    font: 600 0.8rem/1.5 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .doom-specs dd {
    margin: 0;
  }
  .doom-note {
    max-width: 44rem;
    margin-top: var(--s-4);
  }
</style>
