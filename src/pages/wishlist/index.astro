---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { ROUTES } from '../../content/copy/meta';
import { wishlist, wishlistCopy as W } from '../../content/copy/wishlist';
import { url } from '../../lib/paths';

const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---

<Base route={ROUTES.wishlist}>
  <PageHero kicker={W.kicker} title={W.h1} sub={W.sub} />

  <figure class="hero-cube" data-cube-hero>
    <img
      src={url('/illustrations/tungsten-cube.svg')}
      alt={W.heroAlt}
      width="320"
      height="300"
      data-cube-fallback
    />
    <figcaption class="fine">{W.heroCaption}</figcaption>
  </figure>

  <ul class="wishes" role="list" data-wishes>
    {wishlist.map((w) => (
      <li class="wish card" data-wish={w.id}>
        <div class="wish__main">
          <p class="wish__name">{w.name}</p>
          <p class="wish__note">{w.note}</p>
        </div>
        <dl class="wish__meta">
          <div>
            <dt>{W.qty}</dt>
            <dd>{w.qty}</dd>
          </div>
          <div>
            <dt>{W.priority}</dt>
            <dd aria-label={`${w.priority} of 5`}>{stars(w.priority)}</dd>
          </div>
          <div>
            <dt>Price</dt>
            <dd>{w.price}</dd>
          </div>
        </dl>
        <button type="button" class="btn btn--small" data-add-cart>
          {W.add}
        </button>
      </li>
    ))}
  </ul>

  <p class="total card">
    <strong>{W.totalLabel}:</strong>
    {W.total}
  </p>
  <span hidden data-wish-copy={JSON.stringify({ added: W.added })}></span>
</Base>

<script>
  import '../../scenes/wishlist';
</script>

<style>
  .hero-cube {
    margin: 0 auto var(--s-6);
    max-width: 22rem;
    text-align: center;
  }
  .hero-cube img {
    width: 100%;
    height: auto;
  }
  .wishes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .wish {
    display: grid;
    gap: var(--s-3);
    align-items: center;
    padding: var(--s-4);
  }
  @media (min-width: 48rem) {
    .wish {
      grid-template-columns: 1fr auto auto;
    }
  }
  .wish__name {
    font: 700 1.15rem/1.3 var(--font-body);
    margin-bottom: var(--s-1);
  }
  .wish__note {
    color: var(--ink-2);
    margin: 0;
  }
  .wish__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0;
  }
  .wish__meta dt {
    font: 600 0.7rem var(--font-mono);
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .wish__meta dd {
    margin: 0;
    font-weight: 600;
    white-space: nowrap;
  }
  .total {
    margin-top: var(--s-5);
    padding: var(--s-4);
  }
</style>
