---
import Site from '../layouts/Site.astro';
import ArrivalHero from '../components/ArrivalHero.astro';
import CasePanel from '../components/CasePanel.astro';
import { ROUTES } from '../content/site/meta';
import { home } from '../content/site/home';
import { identity } from '../content/resume/identity';
import { entityEncode } from '../lib/paths';
import '../styles/institution.css';

const mail = `<a href="${entityEncode(`mailto:${identity.email}`)}">${entityEncode(identity.email)}</a>`;
---

<Site route={ROUTES.home} printResume formNumber={home.formNumber}>
  <p id="case-chip" class="case-chip" slot="chip" hidden></p>
  <ArrivalHero>
    <CasePanel />
  </ArrivalHero>
  <div id="notice-slot" class="notice-slot"></div>
  <section
    id="contact"
    class="contact-block"
    aria-labelledby="contact-heading"
    data-evidence="contact"
  >
    <h2 id="contact-heading">{home.contactHeading}</h2>
    <p>{home.contactLead}</p>
    <ul class="contact-block__list">
      <li set:html={mail} />
      <li>
        <a href={identity.linkedin.href} rel="noopener noreferrer">
          {identity.linkedin.display}
        </a>
      </li>
      <li>
        <a href={identity.github.href} rel="noopener noreferrer">
          {identity.github.display}
        </a>
      </li>
    </ul>
  </section>
</Site>

<script>
  import '../scripts/home';
</script>
