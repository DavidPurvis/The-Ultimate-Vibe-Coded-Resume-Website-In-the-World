---
import Base from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES } from '../../content/site/meta';
import { rickPage as R } from '../../content/copy/rick';
import { url } from '../../lib/paths';
---

<Base route={ROUTES.rick}>
  <PageHero kicker={R.kicker} title={R.h1} lede={R.body} />
  <div class="btn-row">
    <button type="button" class="btn btn--primary" data-rick-begin>
      <Icon name="play" />
      {R.begin}
    </button>
    <a class="btn" href={url('/#recreation')}>
      {R.skip}
    </a>
  </div>
</Base>

<script>
  import '../../scenes/rickroll/page';
</script>
